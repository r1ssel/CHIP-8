#include <SDL2/SDL.h>
#include <SDL2/SDL_ttf.h>
#include <iostream>
#include <string>
#include <vector>
#include <functional>

const int SCREEN_WIDTH  = 640;
const int SCREEN_HEIGHT = 480;
const uint8_t LIST_SIZE = 10;

std::vector<std::string> list = {
    "test.ch8",
    "lincoln.ch8",
    "breakout.ch8",
    "pong.ch8",
    "salte.ch8",
    "yellow.ch8"
};

const uint16_t BUTTON_WIDTH  = 160;
const uint16_t BUTTON_HEIGHT = 40;


struct Button {
    SDL_Rect rect;
    std::string text;
    bool hovered = false;
    bool pressed = false;
    std::function<void()> onClick;

    bool contains(int x, int y) const {
        return x >= rect.x && x < rect.x + rect.w &&
               y >= rect.y && y < rect.y + rect.h;
    }
};

//  Приложение: все ресурсы в одном месте
struct App {
    SDL_Window*   win  = nullptr;
    SDL_Renderer* ren  = nullptr;
    TTF_Font*     font = nullptr;

    std::vector<Button> buttons;
    bool running = true;

    int clickCount = 0; // для демонстрации
};

void drawRectThick(SDL_Renderer* ren, const SDL_Rect& r, int thickness) {
    SDL_SetRenderDrawColor(ren, 255, 255, 255, 255);
    for (int i = 0; i < thickness; i++) {
        SDL_Rect t = { r.x - i, r.y - i, r.w + i * 2, r.h + i * 2 };
        SDL_RenderDrawRect(ren, &t);
    }
}

//  Инициализация
bool initSDL(App& app) {
    if (SDL_Init(SDL_INIT_VIDEO) != 0) {
        std::cerr << "SDL_Init Error: " << SDL_GetError() << "\n";
        return false;
    }
    if (TTF_Init() != 0) {
        std::cerr << "TTF_Init Error: " << TTF_GetError() << "\n";
        SDL_Quit();
        return false;
    }
    return true;
}

bool initWindow(App& app) {
    app.win = SDL_CreateWindow("Hello SDL2 Button",
                                SDL_WINDOWPOS_CENTERED,
                                SDL_WINDOWPOS_CENTERED,
                                SCREEN_WIDTH, SCREEN_HEIGHT,
                                SDL_WINDOW_SHOWN);
    if (!app.win) {
        std::cerr << "CreateWindow Error: " << SDL_GetError() << "\n";
        return false;
    }
    return true;
}

bool initRenderer(App& app) {
    app.ren = SDL_CreateRenderer(app.win, -1,
                    SDL_RENDERER_ACCELERATED | SDL_RENDERER_PRESENTVSYNC);
    if (!app.ren) {
        std::cerr << "CreateRenderer Error: " << SDL_GetError() << "\n";
        return false;
    }
    return true;
}

bool initFont(App& app) {
    const char* fontPath = "D:/Applications/msys2/ucrt64/share/fonts/TTF/DejaVuSans.ttf";
    app.font = TTF_OpenFont(fontPath, 24);
    if (!app.font) {
        std::cerr << "TTF_OpenFont Error: " << TTF_GetError() << "\n";
        return false;
    }
    return true;
}

//  Завершение
void appShutdown(App& app) {
    if (app.font) TTF_CloseFont(app.font);
    if (app.ren)  SDL_DestroyRenderer(app.ren);
    if (app.win)  SDL_DestroyWindow(app.win);
    TTF_Quit();
    SDL_Quit();

    app.font = nullptr;
    app.ren  = nullptr;
    app.win  = nullptr;
}

bool appInit(App& app) {
    if (!initSDL(app))      return false;
    if (!initWindow(app))   { appShutdown(app); return false; }
    if (!initRenderer(app)) { appShutdown(app); return false; }
    if (!initFont(app))     { appShutdown(app); return false; }
    return true;
}

//  Создание объектов
void createMainMenu(App& app) {
    int y = BUTTON_HEIGHT + 20;
    for (uint8_t i = 0; i < list.size(); i++) {
        Button b1;
        b1.rect = { 20, y, BUTTON_WIDTH, BUTTON_HEIGHT };
        b1.text = list[i];
        b1.onClick = [&app] {
            app.clickCount++;
            std::cout << "Button pressed " << app.clickCount << " times\n";
        };
        app.buttons.push_back(b1);
        y += BUTTON_HEIGHT + 10;
    }
    

    Button exit;
    TTF_SetFontSize(app.font, 12);
    exit.rect = { SCREEN_WIDTH - BUTTON_WIDTH - 20, SCREEN_HEIGHT - BUTTON_HEIGHT - 20, BUTTON_WIDTH, BUTTON_HEIGHT };
    exit.text = "Exit";
    exit.onClick = [&app] { app.running = false; };
    app.buttons.push_back(exit);
    TTF_SetFontSize(app.font, 24);
}

//  Обработка одного события
void handleEvent(App& app, const SDL_Event& e) {
    if (e.type == SDL_QUIT) {
        app.running = false;
        return;
    }

    if (e.type == SDL_MOUSEMOTION) {
        for (auto& b : app.buttons)
            b.hovered = b.contains(e.motion.x, e.motion.y);
    }

    if (e.type == SDL_MOUSEBUTTONDOWN && e.button.button == SDL_BUTTON_LEFT) {
        for (auto& b : app.buttons)
            if (b.contains(e.button.x, e.button.y))
                b.pressed = true;
    }

    if (e.type == SDL_MOUSEBUTTONUP && e.button.button == SDL_BUTTON_LEFT) {
        for (auto& b : app.buttons) {
            if (b.pressed && b.contains(e.button.x, e.button.y) && b.onClick)
                b.onClick();
            b.pressed = false;
        }
    }
}

