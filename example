//  Отрисовка
void drawText(SDL_Renderer* ren, TTF_Font* font, const std::string& text,
              int x, int y, SDL_Color color, bool centered, int boxW)
{
    if (!font || text.empty()) return;

    SDL_Surface* surf = TTF_RenderUTF8_Blended(font, text.c_str(), color);
    if (!surf) return;

    SDL_Texture* tex = SDL_CreateTextureFromSurface(ren, surf);
    if (!tex) { SDL_FreeSurface(surf); return; }

    SDL_Rect dst;
    dst.w = surf->w;
    dst.h = surf->h;
    dst.x = centered ? x + (boxW - surf->w) / 2 : x;
    dst.y = y;

    SDL_RenderCopy(ren, tex, nullptr, &dst);

    SDL_DestroyTexture(tex);
    SDL_FreeSurface(surf);
}

void drawButton(App& app, const Button& b) {
    SDL_Color bg = b.pressed ? SDL_Color{ 50, 50, 50, 255 }
                : b.hovered ? SDL_Color{ 60, 60, 60, 255 }
                            : SDL_Color{ 30, 30, 30, 255 };
    SDL_SetRenderDrawColor(app.ren, bg.r, bg.g, bg.b, bg.a);
    SDL_RenderFillRect(app.ren, &b.rect);

    drawRectThick(app.ren, b.rect, 3);

    if (app.font) {
        drawText(app.ren, app.font, b.text,
                 b.rect.x,
                 b.rect.y + (b.rect.h - 24) / 2,
                 SDL_Color{ 255, 255, 255, 255 },
                 true, b.rect.w);
    }
}

void render(App& app) {
    SDL_SetRenderDrawColor(app.ren, 30, 30, 30, 255);
    SDL_RenderClear(app.ren);

    for (const auto& b : app.buttons)
        drawButton(app, b);

    if (app.font) {
        std::string title = "MENU";
        drawText(app.ren, app.font, title, SCREEN_WIDTH / 2, 20,
                 SDL_Color{ 255, 255, 255, 255 }, true, 0);

        std::string info = "Clicks: " + std::to_string(app.clickCount);
        drawText(app.ren, app.font, info, 20, SCREEN_HEIGHT - 40,
                 SDL_Color{ 200, 200, 200, 255 }, false, 0);
    }

    SDL_RenderPresent(app.ren);
}

//  Главный цикл
void run(App& app) {
    while (app.running) {
        SDL_Event e;
        while (SDL_PollEvent(&e))
            handleEvent(app, e);

        update(app);
        render(app);
    }
}

//  main — только скелет
int main(int argc, char* argv[]) {
    App app;

    if (!appInit(app)) {
        std::cerr << "Failed to initialize application\n";
        return 1;
    }

    createMainMenu(app);
    run(app);
    appShutdown(app);

    return 0;
}